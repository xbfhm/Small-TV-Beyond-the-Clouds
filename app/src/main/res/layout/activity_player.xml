<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000"
    android:focusable="true"
    android:focusableInTouchMode="true"
    android:keepScreenOn="true">

    <!-- 视频画面 -->
    <androidx.media3.ui.PlayerView
        android:id="@+id/playerView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#000000" />

    <!-- 弹幕层 (自绘 TextView 动画池) -->
    <com.yzb.tv.ui.DanmakuView
        android:id="@+id/danmakuView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- 缓冲圈 -->
    <ProgressBar
        android:id="@+id/pbPlayer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:visibility="gone" />

    <!-- 中央播放/暂停大按钮 -->
    <TextView
        android:id="@+id/tvCenterPlay"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="#88000000"
        android:padding="18dp"
        android:text="▶"
        android:textColor="#FFFFFF"
        android:textSize="34sp"
        android:visibility="gone" />

    <!-- 顶部栏 -->
    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="54dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:background="#99000000">

        <Button
            android:id="@+id/btnTopBack"
            style="@style/YzbButton"
            android:text="返回" android:layout_width="wrap_content" android:layout_height="46dp"/>

        <TextView
            android:id="@+id/tvNowPlaying"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="12dp"
            android:ellipsize="end"
            android:singleLine="true"
            android:textColor="#FFFFFF"
            android:textSize="17sp" />

        <Button
            android:id="@+id/btnDmSwitch"
            style="@style/YzbButton"
            android:text="弹幕开" android:layout_width="wrap_content" android:layout_height="46dp"/>

        <Button
            android:id="@+id/btnComment"
            style="@style/YzbButton"
            android:text="评论" android:layout_width="wrap_content" android:layout_height="46dp"/>

    </LinearLayout>

    <!-- 底部控制栏 -->
    <LinearLayout
        android:id="@+id/controlBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:paddingTop="6dp"
        android:paddingBottom="8dp"
        android:background="#99000000">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/tvProgress"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="00:00"
                android:textColor="#FFFFFF"
                android:textSize="14sp" />

            <SeekBar
                android:id="@+id/seekBar"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="10dp"
                android:layout_marginEnd="10dp" />

            <TextView
                android:id="@+id/tvTotal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="00:00"
                android:textColor="#FFFFFF"
                android:textSize="14sp" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center">

            <Button
                android:id="@+id/btnPrevEp"
                style="@style/YzbButton"
                android:text="上一集" android:layout_width="wrap_content" android:layout_height="46dp"/>

            <Button
                android:id="@+id/btnPause"
                style="@style/YzbButton"
                android:layout_marginStart="10dp"
                android:text="暂停" android:layout_width="wrap_content" android:layout_height="46dp"/>

            <Button
                android:id="@+id/btnNextEp"
                style="@style/YzbButton"
                android:layout_marginStart="10dp"
                android:text="下一集" android:layout_width="wrap_content" android:layout_height="46dp"/>

            <Button
                android:id="@+id/btnQuality"
                style="@style/YzbButton"
                android:layout_marginStart="18dp"
                android:text="清晰度" android:layout_width="wrap_content" android:layout_height="46dp"/>

            <Button
                android:id="@+id/btnSpeed"
                style="@style/YzbButton"
                android:text="倍速" android:layout_width="wrap_content" android:layout_height="46dp"/>

        </LinearLayout>

    </LinearLayout>

</FrameLayout>
